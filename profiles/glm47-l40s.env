# Default L40S profile: coding/reasoning main model + separate vision sidecar.
PROFILE_DESCRIPTION="L40S: GLM-4.7-Flash Q4_K + GLM-4.6V-Flash Q8_0"

MAIN_MODEL_HF="ggml-org/GLM-4.7-Flash-GGUF:Q4_K"
MAIN_MODEL_ALIAS="agent-main"
MAIN_CONTEXT=65536
MAIN_MAX_TOKENS=16384
MAIN_INPUT="text"
MAIN_PORT=8000

VISION_ENABLED=true
VISION_MODEL_HF="ggml-org/GLM-4.6V-Flash-GGUF:Q8_0"
VISION_MODEL_ALIAS="agent-vision"
VISION_CONTEXT=16384
VISION_MAX_TOKENS=8192
VISION_PORT=8001
